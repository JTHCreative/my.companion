{
  "cli": {
    "version": ">= 3.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "RCT_BUILD_FROM_SOURCE": "1"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "RCT_BUILD_FROM_SOURCE": "1"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "autoIncrement": true
      },
      "env": {
        "RCT_BUILD_FROM_SOURCE": "1"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
